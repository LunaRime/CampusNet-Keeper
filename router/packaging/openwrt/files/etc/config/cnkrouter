# cnkrouter UCI 配置
# 改完执行：/etc/init.d/cnkrouter restart
#
# 安全提示：本文件含明文密码，请执行
#   chmod 600 /etc/config/cnkrouter

config main 'main'
	option enabled '1'

	# 门户地址：浏览器里被劫持后跳到的那个地址（保留端口；没有端口则按 801 走新式 API）
	option auth_url 'http://10.0.0.1/'

	# 校园网账号（不要带 @cmcc 之类的后缀，由 isp 决定）
	option username ''
	option password ''

	# campus=不带后缀 / cmcc=@cmcc / telecom=@dx / unicom=@lt
	# 也可以用 custom:xxx 直接指定后缀
	option isp 'campus'

	# 在线探测：不要用 msftncsi（部分校园网不可达，会把在线误判成离线）
	option probe_url 'http://captive.apple.com/hotspot-detect.html'
	option probe_expect 'Success'
	option probe_timeout '6'

	# 在线时的巡检间隔（秒）；<=10 会被钳到 60
	option probe_interval '60'

	# 多 WAN 时指定出口源地址（一般留空，走默认路由）
	option bind_ip ''

	# 0=只报错 1=警告 2=信息 3=调试
	# 默认 3：2026-11-01 排查时才发现级别 2 会把 AC 复核、出网验证这些关键判据
	# 全滤掉，日志里只剩一句"域名解析失败"，根本分不出故障层次。
	# 一天一两 MB，54 GB 的数据盘没必要为省空间牺牲证据。
	option log_level '3'

	# 日志按天分文件，落在数据盘：/mnt/data/log/cnkrouter/YYYY-MM-DD.log
	# 为什么：只写 logd 时它只有 128 KB 环形缓冲，一出问题历史就滚没了；
	# 而 54 GB 的数据盘没必要为省空间牺牲可读性。旧文件由 cnk-cleanup 清理。
	# 留空则只写 logd。
	option log_dir '/mnt/data/log/cnkrouter'
	option log_keep_days '7'

	# 1 = 探测到"在线"后再问一次认证服务器（chkstatus）复核
	# 为什么要：本网把 captive.apple.com DNS 劫持到国内 CDN，AC 会话失效后它照样
	# 返回 Success，会导致守护进程"假在线"而不去重连（已实测发生过）。
	option verify_ac '1'

	# 僵尸会话自动处置级别（0=只记录，这是默认）
	# 处置含"换 IP / 换 MAC"这类主动断网动作，误报会亲手制造故障。
	# 先让程序把现场记清楚（日志里有完整判定链），确认是僵尸会话后再调高：
	#   1=发注销  2=+重启WAN换IP  3=+改MAC
	option inuse_action '0'

	# 1 = 链路层故障时自动做「软拔插」（ip link set dev wan down/up）
	#
	# 为什么需要（2026-11-01 真机取证，用户在场且没拔网线，保留了完整现场）：
	#   · 表现：程序判离线 → 主动登录 → loadConfig 失败 → 退避重试，循环 6 次全无效；
	#           用户拔插网线后 1 秒恢复。
	#   · 实测：WAN 有 IP、链路 UP、零错包、DHCP 租约还剩 3 天，但网关 ping 全丢、
	#           ip neigh 里网关是 INCOMPLETE、RX 从 272 包/秒掉到 0.1 包/秒。
	#   · 结论：故障在**二层**（上游端口不再转发、网关不代答 ARP）。
	#           登录/探测/重试全在三层以上，对一个被隔离的端口毫无作用。
	#   · 软拔插实测一次即恢复，且 DHCP 换了新地址（续租拿的还是那个失效的旧地址，
	#     所以必须重新 DHCP 才行）。以下地址均为脱敏占位符，真实值不入库。
	#
	# 触发条件很窄：连续 link_after 次离线 **且** 门户与网关都不可达，才动手。
	# 会断网 5~10 秒。设 0 则只记录判定结果、不动作。
	option link_recovery '1'

	# 期望的 WAN 网卡名。实际动手时以「默认路由所在的口」为准，这项只用于对不上时
	# 打一条告警 —— 这样即使写错，也不会去 down 掉一个无关的接口。
	option wan_iface 'wan'

	# 连续离线几次才触发软拔插
	option link_after '2'

	# 两次软拔插之间的冷却秒数（防反复断网；也别低于 900，
	# 否则一小时内次数太多会撞上 procd 的 respawn 上限）
	option link_cooldown '900'

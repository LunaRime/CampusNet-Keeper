# cnkrouter UCI 配置
# 改完执行：/etc/init.d/cnkrouter restart
#
# 安全提示：本文件含明文密码，请执行
#   chmod 600 /etc/config/cnkrouter

config main 'main'
	option enabled '1'

	# 门户地址：浏览器里被劫持后跳到的那个地址（保留端口；没有端口则按 801 走新式 API）
	option auth_url 'http://10.0.0.1/'

	# 校园网账号（不要带 @cmcc 之类的后缀，由 isp 决定）
	option username ''
	option password ''

	# campus=不带后缀 / cmcc=@cmcc / telecom=@dx / unicom=@lt
	# 也可以用 custom:xxx 直接指定后缀
	option isp 'campus'

	# 在线探测：不要用 msftncsi（部分校园网不可达，会把在线误判成离线）
	option probe_url 'http://captive.apple.com/hotspot-detect.html'
	option probe_expect 'Success'
	option probe_timeout '6'

	# 在线时的巡检间隔（秒）；<=10 会被钳到 60
	option probe_interval '60'

	# 多 WAN 时指定出口源地址（一般留空，走默认路由）
	option bind_ip ''

	# 0=只报错 1=警告 2=信息 3=调试
	option log_level '2'

	# 日志按天分文件，落在数据盘：/mnt/data/log/cnkrouter/YYYY-MM-DD.log
	# 为什么：只写 logd 时它只有 128 KB 环形缓冲，一出问题历史就滚没了；
	# 而 54 GB 的数据盘没必要为省空间牺牲可读性。旧文件由 cnk-cleanup 清理。
	# 留空则只写 logd。
	option log_dir '/mnt/data/log/cnkrouter'
	option log_keep_days '7'

	# 1 = 探测到"在线"后再问一次认证服务器（chkstatus）复核
	# 为什么要：本网把 captive.apple.com DNS 劫持到国内 CDN，AC 会话失效后它照样
	# 返回 Success，会导致守护进程"假在线"而不去重连（已实测发生过）。
	option verify_ac '1'

	# 僵尸会话自动处置级别（0=只记录，这是默认）
	# 处置含"换 IP / 换 MAC"这类主动断网动作，误报会亲手制造故障。
	# 先让程序把现场记清楚（日志里有完整判定链），确认是僵尸会话后再调高：
	#   1=发注销  2=+重启WAN换IP  3=+改MAC
	option inuse_action '0'

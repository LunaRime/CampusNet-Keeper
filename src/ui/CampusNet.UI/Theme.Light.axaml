<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    亮色主题令牌。**本文件是唯一的色值来源**：所有数值取自 DESIGN.md（shadcn/ui），
    对照表见 docs/design/avalonia-mapping.md §1–§3。其它 XAML 里不得出现裸色值
    （有一条检查脚本会断言这一点）。
    暗色主题是亮色的数学反转（DESIGN.md §12），见 Theme.Dark.axaml —— 两份文件的键必须一一对应。
  -->

  <!-- §1 颜色角色 -->
  <SolidColorBrush x:Key="CnkBg" Color="#ffffff"/>
  <SolidColorBrush x:Key="CnkText" Color="#0a0a0a"/>
  <SolidColorBrush x:Key="CnkTextSecondary" Color="#3f3f46"/>
  <SolidColorBrush x:Key="CnkTextMuted" Color="#71717a"/>
  <SolidColorBrush x:Key="CnkTextFaint" Color="#a1a1aa"/>
  <SolidColorBrush x:Key="CnkBrand" Color="#0a0a0a"/>
  <SolidColorBrush x:Key="CnkBrandHover" Color="#1a1a1a"/>
  <SolidColorBrush x:Key="CnkBrandActive" Color="#27272a"/>
  <SolidColorBrush x:Key="CnkOnBrand" Color="#fafafa"/>
  <SolidColorBrush x:Key="CnkSurface" Color="#fafafa"/>
  <SolidColorBrush x:Key="CnkSurfaceStrong" Color="#f4f4f5"/>
  <SolidColorBrush x:Key="CnkSurfaceElevated" Color="#ffffff"/>
  <SolidColorBrush x:Key="CnkBorder" Color="#e4e4e7"/>
  <SolidColorBrush x:Key="CnkBorderSoft" Color="#f4f4f5"/>
  <SolidColorBrush x:Key="CnkBorderStrong" Color="#d4d4d8"/>
  <SolidColorBrush x:Key="CnkInputBorder" Color="#e4e4e7"/>
  <SolidColorBrush x:Key="CnkRing" Color="#0a0a0a"/>
  <SolidColorBrush x:Key="CnkDanger" Color="#ef4444"/>
  <SolidColorBrush x:Key="CnkDangerHover" Color="#dc2626"/>
  <SolidColorBrush x:Key="CnkSuccess" Color="#10b981"/>
  <SolidColorBrush x:Key="CnkWarning" Color="#f59e0b"/>
  <SolidColorBrush x:Key="CnkInfo" Color="#3b82f6"/>
  <!-- rgba(10,10,10,0.1)：Avalonia 用 #AARRGGBB -->
  <SolidColorBrush x:Key="CnkSelection" Color="#1a0a0a0a"/>

  <!-- §2 圆角：由单一 radius 基准 8px 派生（按钮 6 / 卡片 8 / 对话框 12） -->
  <CornerRadius x:Key="CnkRadiusMicro">2</CornerRadius>
  <CornerRadius x:Key="CnkRadiusXs">4</CornerRadius>
  <CornerRadius x:Key="CnkRadiusSm">6</CornerRadius>
  <CornerRadius x:Key="CnkRadiusMd">8</CornerRadius>
  <CornerRadius x:Key="CnkRadiusLg">12</CornerRadius>

  <!-- §3 字号（只取 DESIGN.md 的 type scale） -->
  <x:Double x:Key="CnkFontSizeTitle">24</x:Double>
  <x:Double x:Key="CnkFontSizeHeading">16</x:Double>
  <x:Double x:Key="CnkFontSizeLabel">14</x:Double>
  <x:Double x:Key="CnkFontSizeBody">14</x:Double>
  <x:Double x:Key="CnkFontSizeCaption">12</x:Double>
  <x:Double x:Key="CnkFontSizeMono">13.6</x:Double>

</ResourceDictionary>

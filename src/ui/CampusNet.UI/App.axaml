<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CampusNet.UI.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>

      <!--
        DESIGN.md v2 §3：Windows 原生字体栈 + 平台必需的中文回退。
        刻意不注册 Inter / Geist：前者不在本设计系统里，后者是网页设计系统的遗留。
        SelfTest.cs 会断言两栈分别含 Microsoft YaHei UI 与 Consolas。
      -->
      <FontFamily x:Key="CnkFontSans">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, 微软雅黑, sans-serif</FontFamily>
      <FontFamily x:Key="CnkFontMono">Cascadia Code, Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>

      <!-- 明暗双主题：键一一对应（见 Theme.Light/Dark.axaml，静态检查会断言） -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Light" Source="avares://CampusNet.UI/Theme.Light.axaml"/>
        <ResourceInclude x:Key="Dark" Source="avares://CampusNet.UI/Theme.Dark.axaml"/>
      </ResourceDictionary.ThemeDictionaries>

    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>
    <!-- 全部控件样式集中在这里；视图文件只写结构与绑定 -->
    <StyleInclude Source="avares://CampusNet.UI/Controls.axaml"/>
  </Application.Styles>

</Application>

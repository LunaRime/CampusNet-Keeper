<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    暗色主题令牌：亮色的**数学反转**（DESIGN.md §12）——同样的形状，交换画布与品牌色。
    键必须与 Theme.Light.axaml 完全一一对应（有检查脚本断言）。
    数值取自 DESIGN.md（shadcn/ui），对照表见 docs/design/avalonia-mapping.md §1–§3。
  -->

  <SolidColorBrush x:Key="CnkBg" Color="#0a0a0a"/>
  <SolidColorBrush x:Key="CnkText" Color="#fafafa"/>
  <SolidColorBrush x:Key="CnkTextSecondary" Color="#d4d4d8"/>
  <SolidColorBrush x:Key="CnkTextMuted" Color="#a1a1aa"/>
  <SolidColorBrush x:Key="CnkTextFaint" Color="#71717a"/>
  <SolidColorBrush x:Key="CnkBrand" Color="#fafafa"/>
  <SolidColorBrush x:Key="CnkBrandHover" Color="#e4e4e7"/>
  <SolidColorBrush x:Key="CnkBrandActive" Color="#d4d4d8"/>
  <SolidColorBrush x:Key="CnkOnBrand" Color="#0a0a0a"/>
  <SolidColorBrush x:Key="CnkSurface" Color="#171717"/>
  <SolidColorBrush x:Key="CnkSurfaceStrong" Color="#27272a"/>
  <SolidColorBrush x:Key="CnkSurfaceElevated" Color="#18181b"/>
  <SolidColorBrush x:Key="CnkBorder" Color="#27272a"/>
  <SolidColorBrush x:Key="CnkBorderSoft" Color="#18181b"/>
  <SolidColorBrush x:Key="CnkBorderStrong" Color="#3f3f46"/>
  <SolidColorBrush x:Key="CnkInputBorder" Color="#27272a"/>
  <SolidColorBrush x:Key="CnkRing" Color="#fafafa"/>
  <SolidColorBrush x:Key="CnkDanger" Color="#7f1d1d"/>
  <SolidColorBrush x:Key="CnkDangerHover" Color="#991b1b"/>
  <SolidColorBrush x:Key="CnkSuccess" Color="#10b981"/>
  <SolidColorBrush x:Key="CnkWarning" Color="#f59e0b"/>
  <SolidColorBrush x:Key="CnkInfo" Color="#3b82f6"/>
  <!-- rgba(250,250,250,0.12) -->
  <SolidColorBrush x:Key="CnkSelection" Color="#1ffafafa"/>

  <CornerRadius x:Key="CnkRadiusMicro">2</CornerRadius>
  <CornerRadius x:Key="CnkRadiusXs">4</CornerRadius>
  <CornerRadius x:Key="CnkRadiusSm">6</CornerRadius>
  <CornerRadius x:Key="CnkRadiusMd">8</CornerRadius>
  <CornerRadius x:Key="CnkRadiusLg">12</CornerRadius>
  <CornerRadius x:Key="CnkRadiusPill">9999</CornerRadius>

  <x:Double x:Key="CnkFontSizeTitle">24</x:Double>
  <x:Double x:Key="CnkFontSizeHeading">16</x:Double>
  <x:Double x:Key="CnkFontSizeLabel">14</x:Double>
  <x:Double x:Key="CnkFontSizeBody">14</x:Double>
  <x:Double x:Key="CnkFontSizeCaption">12</x:Double>
  <x:Double x:Key="CnkFontSizeMono">13.6</x:Double>

</ResourceDictionary>

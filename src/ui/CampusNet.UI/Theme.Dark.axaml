<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    DESIGN.md v2 暗色令牌。不是亮色的数学反转、也不是纯黑：
    画布 #0f1218 / 卡片 #1a1f28 / 品牌提亮到 #5b8cff 以保住暗底对比度。
    键必须与 Theme.Light.axaml 逐项一一对应（tools/check_ui_tokens.ps1 会断言）。
  -->

  <!-- 面 -->
  <SolidColorBrush x:Key="CnkBg" Color="#0f1218"/>
  <SolidColorBrush x:Key="CnkTitleBar" Color="#151a22"/>
  <SolidColorBrush x:Key="CnkSurface" Color="#1a1f28"/>
  <SolidColorBrush x:Key="CnkSurfaceStrong" Color="#252c39"/>
  <SolidColorBrush x:Key="CnkSurfaceSubtle" Color="#202632"/>
  <SolidColorBrush x:Key="CnkConsole" Color="#141922"/>
  <SolidColorBrush x:Key="CnkSidebar" Color="#161b23"/>

  <!-- 文字 -->
  <SolidColorBrush x:Key="CnkText" Color="#edf2f9"/>
  <SolidColorBrush x:Key="CnkTextSecondary" Color="#b2bfd0"/>
  <SolidColorBrush x:Key="CnkTextMuted" Color="#8593a6"/>
  <SolidColorBrush x:Key="CnkTextFaint" Color="#5c6a7c"/>

  <!-- 品牌 -->
  <SolidColorBrush x:Key="CnkBrand" Color="#5b8cff"/>
  <SolidColorBrush x:Key="CnkBrandHover" Color="#7aa2ff"/>
  <SolidColorBrush x:Key="CnkBrandActive" Color="#93b4ff"/>
  <SolidColorBrush x:Key="CnkBrandSoft" Color="#1e2c4a"/>
  <SolidColorBrush x:Key="CnkOnBrand" Color="#0f1218"/>

  <!-- 线 / 聚焦 -->
  <SolidColorBrush x:Key="CnkBorder" Color="#2a3240"/>
  <SolidColorBrush x:Key="CnkBorderStrong" Color="#3b4657"/>
  <SolidColorBrush x:Key="CnkInputBorder" Color="#3b4657"/>
  <SolidColorBrush x:Key="CnkRing" Color="#785b8cff"/>
  <SolidColorBrush x:Key="CnkSelection" Color="#245b8cff"/>

  <!-- 语义 -->
  <SolidColorBrush x:Key="CnkSuccess" Color="#3ecf7a"/>
  <SolidColorBrush x:Key="CnkSuccessSoft" Color="#14301f"/>
  <SolidColorBrush x:Key="CnkInfo" Color="#6f9bff"/>
  <SolidColorBrush x:Key="CnkInfoSoft" Color="#1b2a4a"/>
  <SolidColorBrush x:Key="CnkWarning" Color="#f0a942"/>
  <SolidColorBrush x:Key="CnkWarningSoft" Color="#34250e"/>
  <SolidColorBrush x:Key="CnkDanger" Color="#ff6b6b"/>
  <SolidColorBrush x:Key="CnkDangerHover" Color="#ff8f8f"/>
  <SolidColorBrush x:Key="CnkDangerSoft" Color="#3a1a1c"/>
  <SolidColorBrush x:Key="CnkOffline" Color="#94a3b8"/>
  <SolidColorBrush x:Key="CnkOfflineSoft" Color="#242c38"/>

  <!-- 阴影 -->
  <BoxShadows x:Key="CnkShadowCard">0 1 2 0 #28000000, 0 6 18 0 #28000000</BoxShadows>
  <BoxShadows x:Key="CnkShadowRaised">0 2 8 0 #36000000, 0 14 30 0 #36000000</BoxShadows>

  <!-- 形状 -->
  <CornerRadius x:Key="CnkRadiusXs">4</CornerRadius>
  <CornerRadius x:Key="CnkRadiusSm">8</CornerRadius>
  <CornerRadius x:Key="CnkRadiusMd">12</CornerRadius>
  <CornerRadius x:Key="CnkRadiusLg">16</CornerRadius>
  <CornerRadius x:Key="CnkRadiusPill">9999</CornerRadius>

  <!-- 字阶 -->
  <x:Double x:Key="CnkFontSizeTitle">20</x:Double>
  <x:Double x:Key="CnkFontSizeHeading">14</x:Double>
  <x:Double x:Key="CnkFontSizeLabel">12</x:Double>
  <x:Double x:Key="CnkFontSizeBody">13.5</x:Double>
  <x:Double x:Key="CnkFontSizeCaption">11.5</x:Double>
  <x:Double x:Key="CnkFontSizeMono">11.5</x:Double>

  <!-- 尺寸 -->
  <x:Double x:Key="CnkControlHeight">34</x:Double>
  <x:Double x:Key="CnkButtonHeight">36</x:Double>

</ResourceDictionary>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CampusNet.UI.ViewModels"
        xmlns:views="using:CampusNet.UI.Views"
        x:Class="CampusNet.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="校园网助手 — 设置"
        Icon="avares://CampusNet.UI/Assets/app.ico"
        Width="1000" Height="700" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CnkBg}"
        FontFamily="{DynamicResource CnkFontSans}">

  <!--
    DESIGN.md v2：三段 Shell（应用头 / 侧栏+内容 / 底栏）。
    色值只在 Theme.*.axaml；控件样式只在 Controls.axaml；本文件只写结构与绑定。
    分区导航是**纯视图层状态**（code-behind 切 IsVisible / Classes），不新增 VM 字段。
    保留系统标题栏：避免无边框窗口在 Win11 上的 DPI / 拖动 / 圆角兼容问题。

    布局约束：所有星号列显式 MinWidth=0 —— 否则长状态文案/错误文案会按
    DesiredSize 撑开星号列，把右侧按钮或侧栏内容顶出可视区（v0.1.8 修复）。
  -->
  <Grid RowDefinitions="48,*,64">

    <!-- ============ 应用头 ============ -->
    <Border Grid.Row="0"
            Background="{DynamicResource CnkTitleBar}"
            BorderBrush="{DynamicResource CnkBorder}"
            BorderThickness="0,0,0,1"
            Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="26" Height="26"
                CornerRadius="{DynamicResource CnkRadiusSm}"
                Background="{DynamicResource CnkBrand}"
                VerticalAlignment="Center">
          <TextBlock Text="C" FontSize="14" FontWeight="Bold"
                     Foreground="{DynamicResource CnkOnBrand}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Column="1" Text="校园网助手" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource CnkText}"
                   VerticalAlignment="Center" Margin="10,0,8,0"/>

        <!-- 发版时与 src/native/core/Version.h 同步 -->
        <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Classes="caption" Text="v0.1.9"/>
        </Border>

        <TextBlock x:Name="Crumb" Grid.Column="3" Classes="caption" Text="概览 · 设置"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <Border Grid.Column="5" Classes="pill" VerticalAlignment="Center" Margin="0,0,8,0"
                MaxWidth="240"
                Classes.online="{Binding IsOnline}"
                Classes.busy="{Binding IsBusy}"
                Classes.failed="{Binding IsFailed}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Classes="dot"
                    Classes.online="{Binding IsOnline}"
                    Classes.busy="{Binding IsBusy}"
                    Classes.failed="{Binding IsFailed}"
                    Margin="0,0,7,0"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                       FontSize="{DynamicResource CnkFontSizeCaption}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource CnkText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding StatusText}"/>
          </Grid>
        </Border>

        <Button Grid.Column="6" Classes="outline compact" Content="切换主题"
                Click="Theme_Click" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ============ 侧栏 + 内容区 ============ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208"/>
        <ColumnDefinition Width="*" MinWidth="0"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource CnkSidebar}"
              BorderBrush="{DynamicResource CnkBorder}"
              BorderThickness="0,0,1,0"
              Padding="12,14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

          <TextBlock Grid.Row="0" Classes="caption" Text="工作台" Margin="10,0,0,8"/>

          <StackPanel Grid.Row="1">
            <Button x:Name="NavOverview" Classes="nav" Content="概览"
                    Tag="overview" Click="Nav_Click"/>
            <Button x:Name="NavProfiles" Classes="nav" Content="配置档案"
                    Tag="profiles" Click="Nav_Click"/>
            <Button x:Name="NavAdvanced" Classes="nav" Content="高级设置"
                    Tag="advanced" Click="Nav_Click"/>
            <Button x:Name="NavLogs" Classes="nav" Content="运行日志"
                    Tag="logs" Click="Nav_Click"/>
          </StackPanel>

          <Border Grid.Row="2" Height="1" Background="{DynamicResource CnkBorder}"
                  Margin="4,12"/>

          <Grid Grid.Row="3" Margin="10,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="0"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Classes="caption" Text="配置档案"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Classes="ghost compact" Content="＋"
                    Command="{Binding AddProfileCommand}" ToolTip.Tip="新增档案"/>
          </Grid>

          <ListBox Grid.Row="4"
                   ItemsSource="{Binding Profiles}"
                   SelectedItem="{Binding SelectedProfile}"
                   Background="Transparent" BorderThickness="0"
                   HorizontalAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileViewModel">
                <Grid Margin="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Classes="avatar" Margin="0,0,8,0">
                    <Border Classes="dot online" IsVisible="{Binding HasPassword}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium"
                               Foreground="{DynamicResource CnkText}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="caption" Text="{Binding Username}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="5" Classes="panel" Padding="10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Classes="dot"
                      Classes.online="{Binding DaemonRunning}" Margin="0,0,8,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="守护进程" FontSize="{DynamicResource CnkFontSizeCaption}"
                           FontWeight="Medium" Foreground="{DynamicResource CnkText}"/>
                <TextBlock Classes="caption" Text="IPC 连接状态"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- 四个分区叠放，由 code-behind 切 IsVisible；隐藏的不占布局 -->
      <Grid Grid.Column="1">
        <views:OverviewView x:Name="PageOverview" IsVisible="True"/>
        <views:ProfilesView x:Name="PageProfiles" IsVisible="False"/>
        <views:AdvancedView x:Name="PageAdvanced" IsVisible="False"/>
        <views:LogsView x:Name="PageLogs" IsVisible="False"/>
      </Grid>
    </Grid>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="2"
            Background="{DynamicResource CnkSurface}"
            BorderBrush="{DynamicResource CnkBorder}"
            BorderThickness="0,1,0,0"
            Padding="18,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- 长错误文案放星号列并截断，绝不把右侧按钮顶出窗口（2026-10-26 回归） -->
        <TextBlock Grid.Column="0" Classes="error"
                   Text="{Binding LastError}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding LastError}"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Button Classes="ghost" Content="刷新" Command="{Binding RefreshCommand}"/>
          <Button Classes="outline" Content="测试登录" Command="{Binding TestProfileCommand}"/>
          <Button Classes="primary" Content="保存" Command="{Binding SaveCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>

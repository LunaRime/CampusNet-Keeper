<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CampusNet.UI.ViewModels"
             xmlns:svc="using:CampusNet.UI.Services"
             x:Class="CampusNet.UI.Views.ProfilesView"
             x:DataType="vm:MainViewModel">

  <!-- 配置档案：账号与认证策略。所有字段对应 ProfileViewModel 的真实属性。 -->
  <ScrollViewer Classes="page">
    <StackPanel Spacing="16">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Classes="title" Text="配置档案"/>
          <TextBlock Classes="caption" Text="一个档案对应一套账号与认证策略，切换后立即用于自连"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="outline compact" Content="新增档案"
                  Command="{Binding AddProfileCommand}"/>
          <Button Classes="ghost compact" Content="删除"
                  Command="{Binding RemoveProfileCommand}"/>
        </StackPanel>
      </Grid>

      <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
               Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileViewModel">
            <Border Classes="pill" Margin="0,0,8,4">
              <TextBlock Text="{Binding Name}"
                         FontSize="{DynamicResource CnkFontSizeCaption}"/>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 连接信息 -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="heading" Text="连接信息"/>

          <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
              <TextBlock Classes="label" Text="认证网址"/>
              <TextBox Text="{Binding SelectedProfile.AuthUrl}" Watermark="例如门户地址"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
              <TextBlock Classes="label" Text="档案名称"/>
              <TextBox Text="{Binding SelectedProfile.Name}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
              <TextBlock Classes="label" Text="账号"/>
              <TextBox Text="{Binding SelectedProfile.Username}"
                       Watermark="学号 / 手机号（可带运营商后缀）"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
              <TextBlock Classes="label" Text="密码"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SelectedProfile.PasswordInput}"
                         PasswordChar="●"
                         RevealPassword="{Binding SelectedProfile.ShowPassword}"
                         Watermark="{Binding SelectedProfile.PasswordHint}"/>
                <Button Grid.Column="1" Classes="outline" Content="显示" Margin="8,0,0,0"
                        Command="{Binding TogglePasswordCommand}"/>
              </Grid>
              <TextBlock Classes="caption" Margin="0,6,0,0"
                         Text="留空表示不修改已保存的密码；界面不会读取已存明文。"/>
            </StackPanel>
          </Grid>

          <!-- 密码三态：文案来自 PasswordHint，颜色条由视图层按 HasPassword / PasswordState 切换 -->
          <Border x:Name="PwdAlert" Classes="alert">
            <TextBlock x:Name="PwdAlertText" Classes="caption" TextWrapping="Wrap"
                       Text="已保存密码：守护进程持有 DPAPI 密文，界面只显示状态，留空即不修改。"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- 认证策略 -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="heading" Text="认证策略"/>
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="label" Text="运营商"/>
              <ComboBox ItemsSource="{Binding AllCarrierOptions}"
                        SelectedItem="{Binding SelectedCarrier}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:CarrierOption">
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="认证方式"/>
              <ComboBox ItemsSource="{Binding Vendors}"
                        SelectedItem="{Binding SelectedVendor}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:VendorOption">
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>

          <StackPanel IsVisible="{Binding SelectedProfile.IsCustomCarrier}">
            <TextBlock Classes="label" Text="自定义运营商后缀"/>
            <TextBox Text="{Binding SelectedProfile.IspCustom}"
                     Watermark="例如 @cmcc / @telecom（按学校要求填）"/>
          </StackPanel>

          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="运营商显示名由守护进程下发；空名或只回显 id 时走中文映射。锐捷 / 深澜 / 通用表单三条策略尚未在真机验证。"/>
        </StackPanel>
      </Border>

      <Border Classes="alert warn">
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="保存 ≠ 能登录：若当前档案没有密码，自连会提示「密码为空」。保存后请点底栏「测试登录」做一次真实认证验证。"/>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

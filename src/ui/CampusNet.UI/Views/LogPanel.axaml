<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CampusNet.UI.ViewModels"
             x:Class="CampusNet.UI.Views.LogPanel"
             x:DataType="vm:MainViewModel">

  <!--
    日志控制台（DESIGN.md v2 §4）。v2 起日志是独立分区，本控件被 LogsView 复用。
    日志文本来自 MainViewModel.LogText（守护进程每 2 秒拉一次 get_log_tail），
    新行到达时自动滚到底（见 code-behind）。

    ⚠ 不再给内层 ScrollViewer 固定 Height，也不开横向滚动：
    外层 LogsView 用 Grid 把剩余高度交给本控件，整页只有这一条垂直滚动条；
    长日志行改为自动换行，避免出现「外层 + 内层 + 横向」三条滚动条互相抢空间。
  -->
  <Border Classes="console" Padding="14">
    <Grid RowDefinitions="Auto,*">
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="dot busy"/>
          <TextBlock Classes="caption" Text="守护进程日志 · 每 2 秒自动刷新"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="outline compact" Content="打开日志目录"
                Command="{Binding OpenLogFolderCommand}"/>
      </Grid>

      <ScrollViewer x:Name="LogScroll" Grid.Row="1" MinHeight="160"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="LogTextBlock" Classes="logtext"
                             Text="{Binding LogText}"
                             TextWrapping="Wrap"/>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>

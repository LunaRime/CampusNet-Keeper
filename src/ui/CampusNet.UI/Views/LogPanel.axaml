<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CampusNet.UI.ViewModels"
             x:Class="CampusNet.UI.Views.LogPanel"
             x:DataType="vm:MainViewModel">

  <!--
    日志控制台（DESIGN.md v2 §4）。v2 起日志是独立分区，本控件被 LogsView 复用。

    W3 起支持：搜索、级别筛选、复制、暂停跟随。数据流仍是 MainViewModel.LogText
    （守护每 2 秒拉一次 get_log_tail），视图绑的是**过滤后**的 FilteredLogText；
    原始文本不动，清空搜索/筛选就回到全量。

    ⚠ 不给内层 ScrollViewer 固定 Height，也不开横向滚动：
    外层 LogsView 用 Grid 把剩余高度交给本控件，整页只有这一条垂直滚动条；
    长日志行自动换行，避免「外层 + 内层 + 横向」三条滚动条互相抢空间。
  -->
  <Border Classes="console" Padding="14">
    <Grid RowDefinitions="Auto,Auto,*">
      <!-- 标题 + 操作 -->
      <Grid Grid.Row="0" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="dot busy"/>
          <TextBlock Classes="caption" Text="守护进程日志 · 每 2 秒自动刷新"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Classes="caption" Text="（已按字节上限截断，只显示最近部分）"
                     IsVisible="{Binding LogTruncated}"
                     Foreground="{DynamicResource CnkWarning}"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CopyButton" Classes="outline compact" Content="复制"
                  HotKey="Alt+C"
                  Click="Copy_Click"
                  ToolTip.Tip="复制当前筛选结果（不含被过滤掉的行）"/>
          <Button Classes="outline compact" Content="打开日志目录"
                  Command="{Binding OpenLogFolderCommand}"/>
        </StackPanel>
      </Grid>

      <!-- 搜索 / 级别 / 跟随 -->
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="FilterBox"
                 Text="{Binding LogFilter}"
                 Watermark="搜索日志（实时过滤，大小写不敏感）"/>
        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="104"
                  ItemsSource="{Binding LogLevels}"
                  SelectedItem="{Binding LogLevelFilter}"
                  ToolTip.Tip="按级别筛选"/>
        <CheckBox Grid.Column="2" Margin="10,0,0,0" Content="跟随最新"
                  IsChecked="{Binding LogFollow}"
                  ToolTip.Tip="关闭后新日志不再自动滚到底（方便往回翻）"/>
      </Grid>

      <ScrollViewer x:Name="LogScroll" Grid.Row="2" MinHeight="160"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="LogTextBlock" Classes="logtext"
                             Text="{Binding FilteredLogText}"
                             TextWrapping="Wrap"/>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>

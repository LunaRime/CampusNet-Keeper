<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia 外壳工程（任务 23）。
    ⚠ 状态：**尚未构建验证** —— 本机校园网 HTTPS 不通，NuGet 取不到 Avalonia 包
      （见 src/ui/README.md）。文件按计划任务 23 的结构与官方模板形态写好，
      等能取到包后第一次 `dotnet build` 会暴露需要微调之处。
    TFM 用 net10.0-windows：本机只有 .NET SDK 10（无 .NET 9），且计划本身也选了 -windows。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CampusNet.UI</AssemblyName>
    <RootNamespace>CampusNet.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 与守护进程共用同一个图标：注意相对本 csproj（src/ui/CampusNet.UI/）要上溯三级才到仓库根 -->
    <ApplicationIcon>..\..\..\assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本口径：11.x 稳定线；若某版本不可用，三个 Avalonia 包必须一起换（保持同一版本）。
         刻意不引 Avalonia.Fonts.Inter：Inter 不在 DESIGN.md 的字体栈里，
         字体由 App.axaml 的 CnkFontSans/CnkFontMono 决定。 -->
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!--
      显式钉住传递依赖：Avalonia.Desktop → Avalonia.FreeDesktop → Tmds.DBus.Protocol。
      0.21.2 及以下有高危漏洞 CVE-2026-39959 / GHSA-xrw6-gwf8-vvr9（恶意 D-Bus 对端可
      伪造信号、耗尽 fd、用畸形消息体打崩进程；CVSS 7.1）。官方把修复 backport 到 0.21.3。
      只升补丁号，与 0.21.x 的 API 完全兼容；不要顺手升到 0.22+（受影响区间是 <0.92.0 的
      0.22~0.91，跳过它只能直接上 0.92.0，那是跨大版本，得单独验证）。
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口标题栏图标：ApplicationIcon 只作用于 exe（资源管理器/快捷方式），
         Avalonia 的 Window.Icon 需要一份 avares 资源，两者是两码事。
         缺了这条，窗口左上角就是系统默认图标（2026-10-26 用户反馈）。 -->
    <AvaloniaResource Include="..\..\..\assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- IPC 客户端与配置模型放在零依赖的核心库里，可独立构建与跨语言验证 -->
    <ProjectReference Include="..\CampusNet.UI.Core\CampusNet.UI.Core.csproj" />
  </ItemGroup>

</Project>

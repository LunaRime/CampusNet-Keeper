<Project Sdk="Microsoft.NET.Sdk">

  <!--
    跨语言契约自检：C# 客户端 × 真实 C++ PipeServer。
    为什么不用 xunit/nunit：它们都要从 NuGet 取包，而本机校园网 HTTPS 不通
    （Avalonia 也因此装不上）。这里用零依赖的控制台断言，退出码 0 表示全过。
    用法：
      1) 先起 C++ 侧探针服务端：build-m1\Release\cnk_ipc_probe.exe（会打印管道名）
      2) dotnet run 到本项目并传入管道名（省略则按用户 SID 规则自算）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CampusNet.UI.ContractCheck</AssemblyName>
    <RootNamespace>CampusNet.UI.ContractCheck</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampusNet.UI.Core\CampusNet.UI.Core.csproj" />
  </ItemGroup>

</Project>
